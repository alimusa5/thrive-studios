# ─── Email delivery (required for the form to send) ──────────────────────────
# ALL THREE are required together. If any is missing the form refuses to send
# and tells the visitor to email directly, rather than silently delivering to
# a placeholder address.

# https://resend.com/api-keys
RESEND_API_KEY=

# Where audit requests are delivered.
CONTACT_TO_EMAIL=aonraza@thrivestudios.io

# Must be on a domain you have verified in Resend.
# Before your domain verifies, use: Thrive Studios <onboarding@resend.dev>
CONTACT_FROM_EMAIL=Thrive Studios <hello@thrivestudios.io>


# ─── Lead storage (optional — the form works without it) ─────────────────────
# Supabase project settings -> Data API -> Project URL, and
# Project settings -> API keys -> service_role.
#
# ⚠️ The service_role key bypasses Row Level Security. It is a SECRET.
#    Never prefix either of these NEXT_PUBLIC_, and never paste the key into
#    client code — anything NEXT_PUBLIC_ is compiled into the browser bundle.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=


# ─── Site ────────────────────────────────────────────────────────────────────
# Canonical URLs and social cards. Inlined at BUILD time — change it and you
# must redeploy for it to take effect.
NEXT_PUBLIC_SITE_URL=https://thrivestudios.io
