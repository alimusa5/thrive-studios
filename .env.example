# ─── Lead storage (Supabase) ─────────────────────────────────────────────────
# The durable record of every audit request.
#
# Supabase → Project settings → Data API → Project URL
SUPABASE_URL=

# Supabase → Project settings → API keys → service_role
#
# ⚠️ This key bypasses Row Level Security. It is a SECRET.
#    Never prefix it NEXT_PUBLIC_ and never import lib/leads.ts into a client
#    component — anything NEXT_PUBLIC_ is compiled into the browser bundle,
#    and this key would let anyone read every lead you have.
SUPABASE_SERVICE_ROLE_KEY=


# ─── Email notification (Resend) ─────────────────────────────────────────────
# The immediate ping so you do not have to watch the dashboard. All three are
# needed together; miss one and no email is sent.

# https://resend.com/api-keys
RESEND_API_KEY=

# Where the notification lands — your Google Workspace inbox.
CONTACT_TO_EMAIL=aonraza@thrivestudios.io

# Must be on a domain verified in Resend. Before yours verifies, use:
#   Thrive Studios <onboarding@resend.dev>
CONTACT_FROM_EMAIL=Thrive Studios <hello@thrivestudios.io>


# ─── Site ────────────────────────────────────────────────────────────────────
# Canonical URLs and social cards. Inlined at BUILD time — change it and you
# must redeploy for it to take effect.
NEXT_PUBLIC_SITE_URL=https://thrivestudios.io
