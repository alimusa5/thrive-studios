# Contact form delivery. ALL THREE are required — if any is missing the form
# refuses to send and tells the visitor to email directly, rather than
# silently delivering to a placeholder address.

# Create a key at https://resend.com/api-keys
RESEND_API_KEY=

# Where audit requests are delivered.
CONTACT_TO_EMAIL=aonraza@thrivestudios.io

# The verified sending address on your Resend domain.
# Until your own domain is verified you can use: Thrive Studios <onboarding@resend.dev>
CONTACT_FROM_EMAIL=Thrive Studios <hello@thrivestudios.io>

# Your live domain. Used for canonical URLs and social cards.
NEXT_PUBLIC_SITE_URL=https://thrivestudios.io
